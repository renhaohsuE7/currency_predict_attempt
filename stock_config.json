{
    "model_name": "patchtst_sklearn",
    "model_params": {
        "seq_len": 64,
        "pred_len": 15,
        "patch_len": 8,
        "stride": 4,
        "n_estimators": 100,
        "max_depth": 10,
        "random_state": 42
    },
    "symbols": [
        "AAPL"
    ],
    "prediction_horizon": 15,
    "data_collection": {
        "period": "10y",
        "interval": "1d"
    },
    "model_training": {
        "period": "10y",
        "target_column": "Close",
        "target_transform": "log_return",
        "test_days": 120
    },
    "prediction": {
        "period": "10y"
    },
    "capm": {
        "enabled": true,
        "market_index": "^GSPC",
        "risk_free_rate_symbol": "^IRX",
        "rolling_window": 252
    },
    "backtest": {
        "enabled": false,
        "strategy": "rolling",
        "initial_train_days": 252,
        "test_step_days": 30,
        "test_window_days": 30,
        "data_period": "10y"
    }
}
