{
  "model_name": "PatchTST",
  "model_params": {
    "seq_len": 168,
    "pred_len": 24,
    "patch_len": 12,
    "stride": 6,
    "n_estimators": 100,
    "max_depth": 10,
    "random_state": 42
  },
  "data_storage_path": "data",
  "log_level": "INFO",
  "data_collection": {
    "period": "2y",
    "interval": "1d",
    "force_update": false
  },
  "model_training": {
    "period": "1y",
    "target_column": "Close",
    "feature_columns": null,
    "train_params": {
      "validation_split": 0.2
    },
    "test_days": null
  },
  "prediction": {
    "period": "1y",
    "return_uncertainty": true
  },
  "symbols": [
    "USDTWD=X",
    "EURUSD=X",
    "GBPUSD=X"
  ],
  "prediction_horizon": 7,
  "backtest": {
    "enabled": false,
    "strategy": "rolling",
    "initial_train_days": 252,
    "test_step_days": 30,
    "test_window_days": 30,
    "data_period": "3y"
  },
  "capm": {
    "enabled": false,
    "market_index": "^GSPC",
    "risk_free_rate_symbol": "^IRX",
    "rolling_window": 252
  }
}